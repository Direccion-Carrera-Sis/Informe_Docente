{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "incremental": false,  // <-- AQUÍ ESTÁ LA MAGIA
    "skipLibCheck": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  }
}